menu "SDIO Configuration"
	depends on EH_TRANSPORT_CP_SDIO

	choice EH_TRANSPORT_CP_SDIO_MODE
		prompt "SDIO datapath mode"
		# SW_AGGR is the rel-3 DEFAULT (the throughput deliverable). Only the
		# fg-1.x compat personality stays packet (that host can't de-aggregate);
		# rel-3 hosts run dual and adapt to any deployed rel-2 CP.
		default EH_TRANSPORT_CP_SDIO_MODE_PACKET if ESP_HOSTED_CP_LINUX_PEER_FG_V1
		default EH_TRANSPORT_CP_SDIO_MODE_PACKET if ESP_HOSTED_CP_RPC_V1 && !ESP_HOSTED_CP_LINUX_PEER_FG_V2
		default EH_TRANSPORT_CP_SDIO_MODE_SW_AGGR
		help
			How the CP moves frames over SDIO.

			PACKET  — one frame per transfer. Required by legacy Linux /
			          RPC V1 (fg 1.x) hosts.
			STREAM  — IDF hardware batching (SDIO_SLAVE_SEND_STREAM): the
			          host drains queued frames in one large read. Each
			          frame still carries its own header and credit.
			SW_AGGR — software aggregation: multiple 4-byte-aligned frames
			          packed into one transfer, both directions; ~10x fewer
			          bus transactions. Requires a host that negotiated
			          SW_AGGR (buf-config TLV) — upstream fg 2.x or this
			          repo's rel-3 hosts. Requires IDF with commit 4814514
			          (per-chip descriptor limits) for >4092-byte sends.

		config EH_TRANSPORT_CP_SDIO_MODE_PACKET
			bool "Packet (one frame per transfer)"

		config EH_TRANSPORT_CP_SDIO_MODE_STREAM
			bool "Stream (IDF hardware batching)"

		config EH_TRANSPORT_CP_SDIO_MODE_SW_AGGR
			bool "Software aggregation (multi-frame transfers)"
	endchoice

	config EH_TRANSPORT_CP_SDIO_AGGR_TRACE
		bool "SW_AGGR multi-frame trace markers (test/debug only)"
		depends on EH_TRANSPORT_CP_SDIO_MODE_SW_AGGR
		default n
		help
			Log a marker when one SDIO transfer really carries multiple
			frames (TX pack + RX walk). Used by the test suite to prove
			aggregation isn't bypassed. Keep DISABLED in production.

	config EH_TRANSPORT_CP_SDIO_GPIO_RESET
		int "Slave GPIO pin to reset itself"
		default -1
		help
			Host uses this pin to reset the slave ESP. To re-use ESP 'RST' or 'EN' GPIO, set value to -1


	choice EH_TRANSPORT_CP_SDIO_SPEED
		prompt "SDIO Bus Speed"
		default EH_TRANSPORT_CP_SDIO_HIGH_SPEED
		help
			Select the SDIO Slave Bus Speed. Actual speed in use depends on SDIO bus speed the SDIO Master can support

		config EH_TRANSPORT_CP_SDIO_DEFAULT_SPEED
			bool "Default Speed"

		config EH_TRANSPORT_CP_SDIO_HIGH_SPEED
			bool "High Speed"
	endchoice

	menu "Hosted SDIO GPIOs"
		config EH_TRANSPORT_CP_SDIO_PIN_CMD
			int "CMD GPIO number"
			range 15 15 if IDF_TARGET_ESP32
			range 18 18 if IDF_TARGET_ESP32C6
			range 25 25 if IDF_TARGET_ESP32C61
			range 10 10 if IDF_TARGET_ESP32C5
			default 15 if IDF_TARGET_ESP32
			default 18 if IDF_TARGET_ESP32C6
			default 25 if IDF_TARGET_ESP32C61
			default 10 if IDF_TARGET_ESP32C5
			help
				Value cannot be configured. Displayed for reference.

		config EH_TRANSPORT_CP_SDIO_PIN_CLK
			int "CLK GPIO number"
			range 14 14 if IDF_TARGET_ESP32
			range 19 19 if IDF_TARGET_ESP32C6
			range 26 26 if IDF_TARGET_ESP32C61
			range 9 9 if IDF_TARGET_ESP32C5
			default 14 if IDF_TARGET_ESP32
			default 19 if IDF_TARGET_ESP32C6
			default 26 if IDF_TARGET_ESP32C61
			default 9 if IDF_TARGET_ESP32C5
			help
				Value cannot be configured. Displayed for reference.

		config EH_TRANSPORT_CP_SDIO_PIN_D0
			int "D0 GPIO number"
			range 2 2 if IDF_TARGET_ESP32
			range 20 20 if IDF_TARGET_ESP32C6
			range 27 27 if IDF_TARGET_ESP32C61
			range 8 8 if IDF_TARGET_ESP32C5
			default 2 if IDF_TARGET_ESP32
			default 20 if IDF_TARGET_ESP32C6
			default 27 if IDF_TARGET_ESP32C61
			default 8 if IDF_TARGET_ESP32C5
			help
				Value cannot be configured. Displayed for reference.

		config EH_TRANSPORT_CP_SDIO_PIN_D1
			int "D1 GPIO number"
			range 4 4 if IDF_TARGET_ESP32
			range 21 21 if IDF_TARGET_ESP32C6
			range 28 28 if IDF_TARGET_ESP32C61
			range 7 7 if IDF_TARGET_ESP32C5
			default 4 if IDF_TARGET_ESP32
			default 21 if IDF_TARGET_ESP32C6
			default 28 if IDF_TARGET_ESP32C61
			default 7 if IDF_TARGET_ESP32C5
			help
				Value cannot be configured. Displayed for reference.

		config EH_TRANSPORT_CP_SDIO_PIN_D2
			int "D2 GPIO number"
			range 12 12 if IDF_TARGET_ESP32
			range 22 22 if IDF_TARGET_ESP32C6
			range 22 22 if IDF_TARGET_ESP32C61
			range 14 14 if IDF_TARGET_ESP32C5
			default 12 if IDF_TARGET_ESP32
			default 22 if IDF_TARGET_ESP32C6
			default 22 if IDF_TARGET_ESP32C61
			default 14 if IDF_TARGET_ESP32C5
			help
				Value cannot be configured. Displayed for reference.

		config EH_TRANSPORT_CP_SDIO_PIN_D3
			int "D3 GPIO number"
			range 13 13 if IDF_TARGET_ESP32
			range 23 23 if IDF_TARGET_ESP32C6
			range 23 23 if IDF_TARGET_ESP32C61
			range 13 13 if IDF_TARGET_ESP32C5
			default 13 if IDF_TARGET_ESP32
			default 23 if IDF_TARGET_ESP32C6
			default 23 if IDF_TARGET_ESP32C61
			default 13 if IDF_TARGET_ESP32C5
			help
				Value cannot be configured. Displayed for reference.
	endmenu

	choice EH_TRANSPORT_CP_SDIO_TIMING
		prompt "SDIO Slave Timing"
		default EH_TRANSPORT_CP_SDIO_NSEND_PSAMPLE if IDF_TARGET_ESP32C6 && ESP_HOSTED_CP_FOR_LINUX
		default EH_TRANSPORT_CP_SDIO_PSEND_PSAMPLE
		help
			Select the SDIO timing used by slave. Default value works with most
			SDMMC controllers but if transfer errors are encountered, selecting a
			different timing may help resolve the errors.
			See https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-reference/peripherals/sdio_slave.html#_CPPv419sdio_slave_timing_t
			for more information

		config EH_TRANSPORT_CP_SDIO_PSEND_PSAMPLE
			bool "Send at positive edge, sample at positive edge"

		config EH_TRANSPORT_CP_SDIO_NSEND_PSAMPLE
			bool "Send at negative edge, sample at positive edge"

		config EH_TRANSPORT_CP_SDIO_PSEND_NSAMPLE
			bool "Send at positive edge, sample at negative edge"

		config EH_TRANSPORT_CP_SDIO_NSEND_NSAMPLE
			bool "Send at negative edge, sample at negative edge"
	endchoice

	config EH_TRANSPORT_CP_SDIO_TX_Q_SIZE
		int "SDIO TX queue size"
		default 10 if IDF_TARGET_ESP32C61
		default 20
		help
			Very small TX queue will lower ESP --> SDIO -- Host data rate

	config EH_TRANSPORT_CP_SDIO_RX_Q_SIZE
		int "SDIO RX queue size"
		default 10 if IDF_TARGET_ESP32C61
		default 20
		help
			Very small RX queue will lower ESP <-- SDIO -- Host data rate

	config EH_TRANSPORT_CP_SDIO_CHECKSUM
		bool "Enable SDIO payload checksum"
		default n
		help
			16-bit sum over header+payload. Upstream default OFF for SDIO. The CP
			advertises ESP_CHECKSUM_ENABLED and the host mirrors it at runtime
			(agnostic — no host-side knob), so this is the single control point.

endmenu
