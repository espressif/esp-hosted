config ESP_HOSTED_CP_FEAT_RPC_EXT_V1
	bool
	depends on ESP_HOSTED_CP_FEAT_RPC
	depends on ESP_HOSTED_CP_RPC_V1
	default y

config ESP_HOSTED_CP_FEAT_RPC_EXT_V1_READY
    bool
    default y if ESP_HOSTED_CP_FEAT_RPC && ESP_HOSTED_CP_RPC_V1

config ESP_HOSTED_CP_FEAT_RPC_EXT_V1_AUTO_INIT
	bool
	default y if ESP_HOSTED_CP_FEAT_RPC_EXT_V1_READY && ESP_HOSTED_CP_FEAT_RPC_AUTO_INIT && ESP_HOSTED_CP_AUTO_FEAT_INIT
	default n
	depends on ESP_HOSTED_CP_FEAT_RPC_EXT_V1_READY
	depends on ESP_HOSTED_CP_AUTO_FEAT_INIT
	help
		Derived from the RPC mode choice and ESP_HOSTED_CP_FEAT_RPC_AUTO_INIT.
		Registers the Linux-FG request-id range with the CP's RPC dispatcher.
