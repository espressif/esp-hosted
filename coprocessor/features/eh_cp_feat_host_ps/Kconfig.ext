menuconfig ESP_HOSTED_CP_FEAT_HOST_PS
	bool "Host Power Save"
	depends on ESP_HOSTED_CP_FOR_MCU
	default n
	help
		Allow host to enter power save mode.
		Host will notify slave before entering and exiting the power save

if ESP_HOSTED_CP_FEAT_HOST_PS

	config ESP_HOSTED_CP_FEAT_HOST_PS_READY
		bool
		default y if ESP_HOSTED_CP_FOR_MCU

	config ESP_HOSTED_CP_FEAT_HOST_PS_AUTO_INIT
		bool "Auto-initialise Host Power Save at boot"
		default y if ESP_HOSTED_CP_FEAT_HOST_PS_READY && ESP_HOSTED_CP_AUTO_FEAT_INIT
		default n
		depends on ESP_HOSTED_CP_AUTO_FEAT_INIT
		help
			When enabled, Host Power Save auto-initialises during
			eh_cp_init().  Disable to manually call the init from app code
			(e.g. examples that pass host-PS event callbacks at init time).

	menuconfig ESP_HOSTED_CP_FEAT_HOST_PS_DEEP_SLEEP
		bool "Allow host to enter deep sleep. Slave will wakeup host using GPIO when needed"
		default y
		help
			Allow host to enter deep sleep mode. Host will notify slave before entering deep sleep.

	if ESP_HOSTED_CP_FEAT_HOST_PS_DEEP_SLEEP
	menu "Host deep sleep - wakeup config"
		config ESP_HOSTED_CP_FEAT_HOST_PS_WAKE_HOST_ON_CP_BOOT
			bool "Wake the host once when this coprocessor boots"
			default y
			help
			    Pulse the host-wakeup GPIO exactly once, during our own
			    initialisation, so a host that is deep-sleeping learns that this
			    coprocessor restarted.

			    Without it, a coprocessor restart while the host sleeps is
			    unrecoverable and silent: the host only wakes on that line, and
			    we only drive it when traffic arrives for the host - but traffic
			    needs an association, and the association is driven by the host.
			    Nothing breaks the cycle, so the pair stays down until the host
			    is power-cycled by hand.

			    Fires once at boot only. Everything after that respects the
			    normal host power-save handshake. Requires a valid wakeup GPIO.

		config ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO
			int "Slave out: Host wakeup GPIO"
			default 23 if IDF_TARGET_ESP32 && !SPI_VSPI
			default 2 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && !EH_TRANSPORT_CP_SPI_HD
			default 9 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && EH_TRANSPORT_CP_SPI_HD
			default 2 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD && !EH_TRANSPORT_CP_SPI_HD
			default 28 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD && EH_TRANSPORT_CP_SPI_HD
			default 3 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 2 if ESP32P4_TAB5_C6_BOARD
			default -1 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD || ESP32P4_EYE_C6_BOARD
			default 1 if IDF_TARGET_ESP32C3
			default 6 if IDF_TARGET_ESP32C2 && (ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD || ESP_HOSTED_C2_C5_MODULE_SUB_BOARD)
			default -1
		choice ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO_LEVEL
			prompt "Host Wakeup GPIO Level"
			default ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO_LEVEL_HIGH

			config ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO_LEVEL_HIGH
				bool "High"
			config ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO_LEVEL_LOW
				bool "Low"
		endchoice

		config ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO_LEVEL
			int
			default 1 if ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO_LEVEL_HIGH
			default 0 if ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO_LEVEL_LOW
			help
				GPIO level to use for host wakeup from sleep.
				Set to 0 to use low level, set to 1 to use high level.
	endmenu
	endif # ESP_HOSTED_CP_FEAT_HOST_PS_DEEP_SLEEP

	config ESP_HOSTED_CP_FEAT_HOST_PS_UNLOAD_BUS_WHILE_SLEEPING
		bool "Unload low level BUS driver during host deep sleep"
		default y
		help
			Default y because it is the enabling condition for CP light
			sleep, not an optimisation: with the bus driver still
			installed the chip never really sleeps. It also made the
			transports disagree - sdio_deinit runs unconditionally while
			uart/spi/spi_hd wrap their whole body in this option, so at
			the old default n three of four never unloaded at all.

	config ESP_HOSTED_CP_FEAT_HOST_PS_PRINT_FULL_WAKEUP_PACKET
		bool "Print the full wakeup packet"
		default n

endif # ESP_HOSTED_CP_FEAT_HOST_PS
