# sdkconfig.rename — legacy MCU slave (esp_hosted_mcu) -> new CP (ESP_HOSTED_CP_*) Kconfig symbols.
#
# Format: OLD_NAME NEW_NAME (IDF auto-discovers this file during build).
# Only unambiguous 1:1 mappings are listed here. Legacy symbols without a direct
# new equivalent (BROKER_*, example-specific, dev-board choice internals, etc.)
# are intentionally omitted — users of those legacy defaults must re-configure.

# Role selection
CONFIG_ESP_HOSTED_COPROCESSOR CONFIG_ESP_HOSTED_CP

# Feature enables (legacy flat names -> new CP_FEAT_* namespace)
CONFIG_ESP_HOSTED_CP_WIFI                   CONFIG_ESP_HOSTED_CP_FEAT_WIFI
CONFIG_ESP_HOSTED_CP_BT                     CONFIG_ESP_HOSTED_CP_FEAT_BT
CONFIG_ESP_HOSTED_NETWORK_SPLIT_ENABLED     CONFIG_ESP_HOSTED_CP_FEAT_NW_SPLIT
CONFIG_ESP_HOSTED_HOST_POWER_SAVE_ENABLED   CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS
CONFIG_ESP_HOSTED_CLI_ENABLED               CONFIG_ESP_HOSTED_CP_FEAT_CLI
CONFIG_ESP_HOSTED_MEM_MONITOR               CONFIG_ESP_HOSTED_CP_FEAT_MEM_MONITOR
CONFIG_ESP_HOSTED_CP_EXT_COEX               CONFIG_ESP_HOSTED_CP_FEAT_EXT_COEX
CONFIG_ESP_HOSTED_ENABLE_GPIO_EXPANDER      CONFIG_ESP_HOSTED_CP_FEAT_GPIO_EXP
CONFIG_ESP_HOSTED_ENABLE_PEER_DATA_TRANSFER CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA
CONFIG_ESP_HOSTED_LIGHT_SLEEP_ENABLE        CONFIG_ESP_HOSTED_CP_FEAT_LIGHT_SLEEP

# Spec-alignment renames (cp_3.0 internal — bring to FEAT_* parity with host)
CONFIG_ESP_HOSTED_CP_EXT_RPC                    CONFIG_ESP_HOSTED_CP_FEAT_RPC
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA_TRANSFER    CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA

# Common board-symbol normalization.
CONFIG_ESP_HOST_DEV_BOARD_NONE              CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE
CONFIG_ESP_HOST_DEV_BOARD_P4_FUNC_BOARD     CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD
CONFIG_C2_C5_MODULE_SUB_BOARD               CONFIG_ESP_HOSTED_C2_C5_MODULE_SUB_BOARD
