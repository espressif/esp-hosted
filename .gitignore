# ── Test-lab working state (machine-local, never tracked) ────────────────
# ONE sandbox-bindable root, split by lifecycle:
#   tests/.work/cache/     reused build artifacts (COW proj dirs + flash images)
#   tests/.work/runs/<ts>/ per-run scratch + reports (logs, report.md, live.log)
#   tests/.work/sock/      emu Unix sockets
# Shared by the pytest framework AND the esplab runner.
tests/.work/
# Legacy esplab output (pre-unification); both now write under tests/.work/.
tools/esplab/runs/
# Machine-local HW bench identity (ports/baud for one physical setup).
tests/lab.local.json

# Local agent instructions — keep out of git.
CLAUDE.md

# CI compiler cache (persisted via GitLab cache)
.ccache/

# registry README generator preview output (disposable)
tmp_registry_readmes/

