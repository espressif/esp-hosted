# TLV group selection — hidden, auto-selected from RPC version.
# Sourced by coprocessor (and later host) parent Kconfig.
# No user-visible options.

config ESP_HOSTED_TLV_V1
    bool
    default y if ESP_HOSTED_CP_RPC_V1

config ESP_HOSTED_TLV_V2
    bool
    default y if ESP_HOSTED_CP_RPC_V2

config ESP_HOSTED_TLV_V3
    bool
    # Never on a for-MCU CP: V3 adds FEAT_CAPS(0x19, 34B) + endpoint strings,
    # blowing the 64-byte init-event cap that deployed rel-2 MCU hosts
    # assert-crash on (transport_drv.c assert(len < 64) @724065d).
    depends on !ESP_HOSTED_CP_FOR_MCU
    default n
