# SPDX-License-Identifier: Apache-2.0
# wifi/dpp/mcu_host — Wi-Fi STA + DPP on host MCU

CONFIG_ESP_HOSTED=y

CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y

CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_EXT_DPP=y


CONFIG_BT_ENABLED=n

# DPP pulls wpa_supplicant DPP + mbedtls → larger image.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

CONFIG_FREERTOS_HZ=1000

# Don't reuse any saved Wi-Fi config on the CP (DPP supplies fresh creds).
CONFIG_WIFI_RMT_NVS_ENABLED=n
