# SPDX-License-Identifier: Apache-2.0
# Linux host defaults — system feature only (proven on posix). Wi-Fi/gpio/coex
# command groups are feat-gated in eh_api_cmd.c, so they compile only where the
# feature is enabled; this role exercises the system surface for mcu<->linux parity.
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST=y
CONFIG_ESP_HOSTED_HOST_TYPE_POSIX=y
CONFIG_ESP_HOSTED_HOST_PORT_TYPE_POSIX=y
CONFIG_ESP_HOSTED_HOST_VSERIAL_LINUX=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_AUTO_FEAT_INIT=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM_AUTO_INIT=y

# Wi-Fi/gpio/coex on the Linux host too (control-plane RPC over vserial) — brings
# the wifi/gpio/coex exerciser commands to linux for full mcu<->linux parity.
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
CONFIG_ESP_HOSTED_HOST_FEAT_GPIO_EXP=y
CONFIG_ESP_HOSTED_HOST_FEAT_CP_EXT_COEX=y
