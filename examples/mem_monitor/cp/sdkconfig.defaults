# ── Role: COPROCESSOR ────────────────────────────────────────────────
# ESP-Hosted coprocessor firmware (works with both MCU and Linux hosts
# via the unified MCU RPC v1 wire).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

#Disable enterprise support by default
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# BT Configuration
CONFIG_BT_ENABLED=n
#CONFIG_BT_CONTROLLER_ONLY=y

# OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

# OS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y

CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y

# Scenario feature gate — the standalone eh_cp_feat_mem_monitor was
# folded into eh_cp_feat_debug as the MEM_MONITOR sub-feature.  Enable
# the parent + the sub-feature; HEAP_STATS sub-feature stays off for
# this scenario.
CONFIG_ESP_HOSTED_CP_FEAT_DEBUG=y
CONFIG_ESP_HOSTED_CP_FEAT_DEBUG_MEM_MONITOR=y
# CONFIG_ESP_HOSTED_CP_FEAT_DEBUG_HEAP_STATS is not set
