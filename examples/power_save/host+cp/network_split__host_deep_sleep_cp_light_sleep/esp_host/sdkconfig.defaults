CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n

CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_TASK_PRIO=23

CONFIG_IPERF_TRAFFIC_TASK_PRIORITY=23
CONFIG_IPERF_REPORT_TASK_PRIORITY=24
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Role: HOST (MCU / ESP-IDF)
CONFIG_ESP_HOSTED=y

CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
CONFIG_ESP_HOSTED_HOST_FEAT_NW_SPLIT=y
CONFIG_ESP_HOSTED_HOST_FEAT_POWER_SAVE=y


# Wi-Fi extensions wired through esp_wifi_remote_glue bridges.
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_EXT_ITWT=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_EXT_DPP=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_EXT_ENT=y

CONFIG_ESP_HOSTED_HOST_FEAT_POWER_SAVE_DEEP_SLEEP_ALLOWED=y

# wifi-cmd managed component skips its own netif init; nw_split auto-init
# already created WIFI_STA_DEF.
CONFIG_WIFI_CMD_NO_LWIP=y

# nw_split netif IP source: host netif gets IP from CP DhcpDnsStatus event.
CONFIG_ESP_HOSTED_HOST_FEAT_NW_SPLIT_NETIF_INTERNAL_STATIC=y

# wifi-cmd is the single connect owner; disable hosted reconnect hooks.
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_STA_AUTO_CONNECT_ON_START=n
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_STA_AUTO_RECONNECT_ON_DISCONNECT=n

CONFIG_ESP_HOSTED_HOST_FEAT_CLI_AUTO_INIT=y
