# CP-side overlay enabling the host-power-save combo on top of the
# network_split base.  Apply alongside the per-target defaults via
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.ci.host_power_save"
#
# Restored from the (now-deleted) `examples/network_split__host_power_save/`
# dir.  The combo is a sdkconfig variant of the network_split scenarios,
# not a separate scenario; this overlay is the canonical place for it.

CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Network Split
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_HOSTED_CP_FEAT_NW_SPLIT=y

# Host Power Save
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS=y
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_DEEP_SLEEP=y
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO=2
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO_LEVEL_HIGH=y

# CLI (for wake-up-host command)
CONFIG_ESP_HOSTED_CP_FEAT_CLI=y

# WiFi configuration
CONFIG_EXAMPLE_WIFI_SSID="myssid"
CONFIG_EXAMPLE_WIFI_PASSWORD="mypassword!123"
CONFIG_EXAMPLE_WIFI_CONN_MAX_RETRY=6
CONFIG_EXAMPLE_WIFI_AUTH_WPA2_PSK=y
CONFIG_ESP_HOSTED_CP_FEAT_NW_SPLIT_WIFI_AUTO_CONNECT_ON_STA_START=y
