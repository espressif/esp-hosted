# CONFIG_ESP_HOSTED_CP_FEAT_DEBUG_HEAP_TRACING=y
# CONFIG_ESP_HOSTED_CP_FEAT_DEBUG_HEAP_TRACE_RECORDS=400

CONFIG_ESP_HOSTED_CP_LIGHT_SLEEP_POWER_MAX=y
