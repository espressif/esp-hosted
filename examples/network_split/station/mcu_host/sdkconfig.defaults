CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

CONFIG_EH_EXAMPLE_WIFI_SSID="myssid"
CONFIG_EH_EXAMPLE_WIFI_PASSWORD="mypassword"
CONFIG_EH_EXAMPLE_WIFI_MAXIMUM_RETRY=6
CONFIG_EH_EXAMPLE_WIFI_AUTH_WPA2_PSK=y

# OTA partition layout
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Throughput / latency hardening (matches upstream host_network_split__power_save)
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_TASK_PRIO=23

CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
CONFIG_ESP_HOSTED_HOST_FEAT_NW_SPLIT=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
