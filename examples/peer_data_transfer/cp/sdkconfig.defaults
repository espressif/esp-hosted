# ── Role: COPROCESSOR ────────────────────────────────────────────────
# ESP-Hosted coprocessor firmware (works with both MCU and Linux hosts
# via the unified MCU RPC v1 wire).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

# BT Configuration
CONFIG_BT_ENABLED=n
# Wi-Fi and BT disabled for this example
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n

# OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

# OS
CONFIG_FREERTOS_HZ=1000

# Feature
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y
