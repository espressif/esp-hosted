CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# BT Configuration
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=
CONFIG_BTDM_CONTROLLER_MODE_BTDM=y
CONFIG_BTDM_CTRL_AUTO_LATENCY=y
CONFIG_BTDM_CONTROLLER_MODEM_SLEEP=y
CONFIG_BTDM_CTRL_MODEM_SLEEP=y

# BT over UART
CONFIG_BTDM_CONTROLLER_HCI_MODE_UART_H4=y
CONFIG_BTDM_CTRL_HCI_MODE_UART_H4=y

#CO-EX config
CONFIG_FREERTOS_UNICORE=n
CONFIG_BTDM_CONTROLLER_PINNED_TO_CORE=0
CONFIG_BTDM_CTRL_PINNED_TO_CORE=0
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y


# OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# partitions
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

# iram optimization
CONFIG_ESP_SYSTEM_ESP32_SRAM1_REGION_AS_IRAM=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
#CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# OS
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=n
