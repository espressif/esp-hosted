menu "ESP-Hosted NimBLE bridge"

config ESP_HOSTED_HCI_NIMBLE_DEBUG
    bool "Enable bridge debug logs"
    default n
    help
      Verbose logging in the bridge TU. Useful for diagnosing HCI
      framing issues during bring-up; leave off for production.

# NimBLE's HCI framing constants come from NimBLE headers; no
# user-tunable knobs are needed at the bridge level.

endmenu
