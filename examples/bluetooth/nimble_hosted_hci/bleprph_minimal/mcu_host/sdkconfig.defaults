# Role: HOST (MCU)
CONFIG_ESP_HOSTED=y

# Features: BT (NimBLE) + the NimBLE hosted-HCI port.
# The port auto-inits at boot by default (BT_PORT_NIMBLE_AUTO_INIT, on when
# AUTO_FEAT_INIT is) — no sdkconfig knob and no app call needed.
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_ESP_HOSTED_HOST_BT_PORT_NIMBLE=y

# Transport: MCU default

CONFIG_FREERTOS_HZ=1000

# NimBLE host stack — local controller disabled (CP supplies it).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_42_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# Wi-Fi Remote (typically required alongside Hosted)
