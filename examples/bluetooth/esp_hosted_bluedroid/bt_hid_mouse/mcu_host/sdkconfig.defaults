# Role: HOST (MCU)
CONFIG_ESP_HOSTED=y

# Features: BT (Bluedroid)
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
# This example attaches the HCI driver itself, so opt out of port auto-init.
CONFIG_ESP_HOSTED_HOST_BT_PORT_BLUEDROID=y
CONFIG_ESP_HOSTED_HOST_BT_PORT_BLUEDROID_AUTO_INIT=n

# CP target: ESP32 — Classic BT (BR/EDR) only exists on the original ESP32.
CONFIG_SLAVE_IDF_TARGET_ESP32=y

# Transport: MCU default

CONFIG_FREERTOS_HZ=1000

# Bluedroid with Classic BT + HID device; local controller disabled (CP supplies it).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
# Bluedroid stack-mode hint — drives BR/EDR feature gates even with local controller disabled.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Wi-Fi Remote (typically required alongside Hosted)
