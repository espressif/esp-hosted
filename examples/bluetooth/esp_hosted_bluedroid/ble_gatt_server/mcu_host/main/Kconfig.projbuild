menu "BLE GATT Server config"

config EXAMPLE_DEVICE_NAME
    string "BLE device name"
    default "ESP_HOSTED_GATTS"

config EXAMPLE_NOTIFY_INTERVAL_MS
    int "Notification interval (ms)"
    default 1000
    range 100 60000
    help
      The notify-characteristic task increments a counter and pushes
      it to subscribed clients at this cadence.

endmenu
