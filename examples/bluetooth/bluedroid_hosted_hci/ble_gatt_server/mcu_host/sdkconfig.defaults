# Role: HOST (MCU)
CONFIG_ESP_HOSTED=y

# Features: BT (Bluedroid) + the Bluedroid hosted-HCI port.
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_ESP_HOSTED_HOST_BT_PORT_BLUEDROID=y
# P1: explicit eh_host_bluedroid_init() (auto-init path is a follow-up).
CONFIG_ESP_HOSTED_HOST_BT_PORT_BLUEDROID_AUTO_INIT=n

# Transport: MCU default

CONFIG_FREERTOS_HZ=1000

# Bluedroid (BLE side), local controller disabled (CP supplies it).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n

# Wi-Fi Remote (typically required alongside Hosted)
