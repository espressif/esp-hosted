# Role: HOST (MCU)
CONFIG_ESP_HOSTED=y

# Features: BT. The stack is chosen by the IDF BT Kconfig (BT_NIMBLE_ENABLED
# below); the app calls esp_hosted_bt_stack_setup().
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y

# Transport: MCU default

CONFIG_FREERTOS_HZ=1000

# NimBLE host stack — local controller disabled (CP supplies it).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_42_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# Wi-Fi Remote (typically required alongside Hosted)
