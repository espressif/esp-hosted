menu "Example Configuration"

    config EXAMPLE_PING_IP
        string "Ping target"
        default "1.1.1.1"
        help
            Hostname or IP the coexistence demo pings to keep WiFi
            traffic alive while BLE advertises.

    config EXAMPLE_PING_COUNT
        int "Ping count"
        default 100
        help
            Number of pings sent (one per second).  Raise for soak
            testing the coexistence path.

endmenu
