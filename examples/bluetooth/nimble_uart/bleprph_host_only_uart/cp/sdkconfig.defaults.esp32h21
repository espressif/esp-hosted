# 1. CPU
#--------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_96=y

# 2. BT Configuration
#---------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=
CONFIG_BT_LE_SLEEP_ENABLE=y

# BLE over UART
#-------------------
# Enable below config, delete sdkconfig, build/ and rebuild
CONFIG_BT_LE_HCI_INTERFACE_USE_UART=y
CONFIG_BT_LE_HCI_UART_TX_PIN=19
CONFIG_BT_LE_HCI_UART_RX_PIN=10
CONFIG_BT_LE_HCI_UART_FLOWCTRL=n
# # 4 pin solution is not working yet for c6
# #CONFIG_BT_LE_HCI_UART_RTS_PIN=4
# #CONFIG_BT_LE_HCI_UART_CTS_PIN=5


# Partition Table
#--------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

# Mempool
#------------
CONFIG_ESP_CACHE_MALLOC=y


# Optimizations
#-------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y


