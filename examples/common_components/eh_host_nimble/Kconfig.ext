menu "ESP-Hosted NimBLE port"

config ESP_HOSTED_HOST_BT_PORT_NIMBLE
	bool "NimBLE hosted-HCI port"
	depends on ESP_HOSTED_HOST_FEAT_BT && BT_NIMBLE_ENABLED
	default n
	help
	  Build the NimBLE <-> ESP-Hosted HCI port so a NimBLE host stack
	  runs over the hosted transport. Requires the BT feature and IDF's
	  NimBLE host (BT_NIMBLE_ENABLED).

if ESP_HOSTED_HOST_BT_PORT_NIMBLE

	config ESP_HOSTED_HOST_BT_PORT_NIMBLE_AUTO_INIT
		bool "Auto-initialise the NimBLE port at boot"
		depends on ESP_HOSTED_HOST_AUTO_FEAT_INIT
		default y
		help
		  Run eh_host_nimble_init() during host auto-init (priority after
		  feat_bt). Disable to call eh_host_nimble_init()/_deinit() from
		  the app yourself.

	config ESP_HOSTED_HCI_NIMBLE_DEBUG
		bool "Enable port debug logs"
		default n
		help
		  Verbose logging in the port TU; leave off for production.

endif # ESP_HOSTED_HOST_BT_PORT_NIMBLE

endmenu
