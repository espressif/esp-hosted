menu "ESP-Hosted Bluedroid port"

config ESP_HOSTED_HOST_BT_PORT_BLUEDROID
	bool "Bluedroid hosted-HCI port"
	depends on ESP_HOSTED_HOST_FEAT_BT && BT_BLUEDROID_ENABLED
	default n
	help
	  Build the Bluedroid <-> ESP-Hosted HCI port so a Bluedroid host
	  stack runs over the hosted transport. Requires the BT feature and
	  IDF's Bluedroid host (BT_BLUEDROID_ENABLED).

if ESP_HOSTED_HOST_BT_PORT_BLUEDROID

	config ESP_HOSTED_HOST_BT_PORT_BLUEDROID_AUTO_INIT
		bool "Auto-initialise the Bluedroid port at boot"
		depends on ESP_HOSTED_HOST_AUTO_FEAT_INIT
		default y
		help
		  Run eh_host_bluedroid_init() during host auto-init (priority
		  after feat_bt). Disable to call eh_host_bluedroid_init()/_deinit()
		  from the app yourself.

	config ESP_HOSTED_HCI_BLUEDROID_RX_SCRATCH_SIZE
		int "RX scratch buffer size (bytes)"
		default 1100
		range 260 4096
		help
		  RX scratch buffer for H4 restitching. Default 1100 fits both
		  HCI events (max 257) and ACL (max 1027) with headroom.

	config ESP_HOSTED_HCI_BLUEDROID_DEBUG
		bool "Enable port debug logs"
		default n
		help
		  Verbose logging in the port TU; leave off for production.

endif # ESP_HOSTED_HOST_BT_PORT_BLUEDROID

endmenu
