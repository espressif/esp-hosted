menu "Example Connection Configuration"

    config EH_EXAMPLE_WIFI_SSID
        string "WiFi SSID"
        default "myssid"

    config EH_EXAMPLE_WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"

    config EH_EXAMPLE_WIFI_MAXIMUM_RETRY
        int "Maximum retry"
        default 6

    choice EH_EXAMPLE_WIFI_BAND
        prompt "WiFi band (dual-band CP, e.g. ESP32-C5)"
        default EH_EXAMPLE_WIFI_BAND_AUTO
        help
            Only applies to a dual-band CP (SLAVE_SOC_WIFI_SUPPORT_5G). 2G is the
            most reliable for a 2.4 GHz AP; AUTO scans both bands but is slow and
            can stall on the C5; 5G for a 5 GHz AP. A single-band CP (e.g. C6)
            ignores this.
        config EH_EXAMPLE_WIFI_BAND_2G
            bool "2.4 GHz only"
        config EH_EXAMPLE_WIFI_BAND_5G
            bool "5 GHz only"
        config EH_EXAMPLE_WIFI_BAND_AUTO
            bool "Auto (2.4 + 5 GHz)"
    endchoice

    choice EH_EXAMPLE_WIFI_BANDWIDTH
        prompt "STA channel bandwidth"
        default EH_EXAMPLE_WIFI_BW_AUTO
        help
            Fixes the STA channel width, mainly for throughput characterization
            (20 vs 40 MHz). AUTO (default) leaves it to negotiation with the AP.
            HT20 pins 20 MHz; HT40 pins 40 MHz (the AP must offer 40 MHz, else it
            negotiates down). Applied after esp_wifi_start(), before connect; the
            RPC forwards it to the CP. A CP that doesn't support the call logs a
            warning and falls back to negotiation (non-fatal).
        config EH_EXAMPLE_WIFI_BW_AUTO
            bool "Auto (negotiate with AP)"
        config EH_EXAMPLE_WIFI_BW_HT20
            bool "20 MHz (HT20)"
        config EH_EXAMPLE_WIFI_BW_HT40
            bool "40 MHz (HT40)"
    endchoice

    choice EH_EXAMPLE_WIFI_PROTOCOL
        prompt "STA PHY protocol"
        default EH_EXAMPLE_WIFI_PROTO_DEFAULT
        help
            802.11 protocol the STA advertises. "Default" leaves the CP's max
            (typically 11ax on a Wi-Fi 6 SoC) — best for a normal connect. The
            presets matter for throughput tuning: HT40 needs 11n, and on an
            11AX SoC the single-band set_bandwidth caps at HT20, so pin "up to
            11n" + HT40 to force a 40 MHz test. Applied after esp_wifi_start(),
            before bandwidth; RPC-forwarded; non-fatal.
        config EH_EXAMPLE_WIFI_PROTO_DEFAULT
            bool "Default (CP max / negotiated)"
        config EH_EXAMPLE_WIFI_PROTO_LEGACY
            bool "Legacy 11b/g only"
        config EH_EXAMPLE_WIFI_PROTO_11N
            bool "up to 11n (enables HT40)"
        config EH_EXAMPLE_WIFI_PROTO_11AX
            bool "up to 11ax (Wi-Fi 6)"
    endchoice

    config EH_EXAMPLE_WIFI_COUNTRY
        string "WiFi country code"
        default "01"
        help
            Regulatory country code governing which channels are permitted —
            notably which 5 GHz channels are legal. "01" is the worldwide-safe
            set. Empty string leaves the CP default. Applied after
            esp_wifi_start(), before connect (RPC-forwarded); non-fatal if the CP
            rejects the code.

            Supported codes:
              01 (world), AT AU BE BG BR CA CH CN CY CZ DE DK EE ES FI FR GB GR
              HK HR HU IE IN IS IT JP KR LI LT LU LV MT MX NL NO NZ PL PT RO SE
              SI SK TW US

    # STA auth-mode threshold + WPA3 SAE PWE — for examples that drive an
    # explicit connect (network_split station/iperf). Values mirror IDF's
    # protocol_examples_common so migrated examples keep identical behaviour.
    choice EH_EXAMPLE_WIFI_AUTH_MODE
        prompt "STA scan auth-mode threshold"
        default EH_EXAMPLE_WIFI_AUTH_OPEN
        help
            Weakest auth mode the STA accepts while scanning for the AP.
        config EH_EXAMPLE_WIFI_AUTH_OPEN
            bool "OPEN"
        config EH_EXAMPLE_WIFI_AUTH_WEP
            bool "WEP"
        config EH_EXAMPLE_WIFI_AUTH_WPA_PSK
            bool "WPA PSK"
        config EH_EXAMPLE_WIFI_AUTH_WPA2_PSK
            bool "WPA2 PSK"
        config EH_EXAMPLE_WIFI_AUTH_WPA_WPA2_PSK
            bool "WPA/WPA2 PSK"
        config EH_EXAMPLE_WIFI_AUTH_WPA3_PSK
            bool "WPA3 PSK"
        config EH_EXAMPLE_WIFI_AUTH_WPA2_WPA3_PSK
            bool "WPA2/WPA3 PSK"
        config EH_EXAMPLE_WIFI_AUTH_WAPI_PSK
            bool "WAPI PSK"
    endchoice

    choice EH_EXAMPLE_WIFI_SAE_MODE
        prompt "WPA3 SAE PWE derivation"
        default EH_EXAMPLE_STATION_WPA3_SAE_PWE_BOTH
        help
            WPA3 SAE password-element derivation: hunt-and-peck, H2E, or both.
        config EH_EXAMPLE_STATION_WPA3_SAE_PWE_HUNT_AND_PECK
            bool "HUNT AND PECK"
        config EH_EXAMPLE_STATION_WPA3_SAE_PWE_HASH_TO_ELEMENT
            bool "H2E"
        config EH_EXAMPLE_STATION_WPA3_SAE_PWE_BOTH
            bool "BOTH"
    endchoice

    config EH_EXAMPLE_WIFI_PW_ID
        string "WPA3 SAE password identifier (H2E)"
        depends on EH_EXAMPLE_STATION_WPA3_SAE_PWE_HASH_TO_ELEMENT || EH_EXAMPLE_STATION_WPA3_SAE_PWE_BOTH
        default ""

endmenu
