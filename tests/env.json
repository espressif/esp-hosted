{
  "hardware": {
    "host_port": "/dev/cu.usbserial-1120",
    "slave_port": "/dev/cu.usbserial-11301",
    "board": "ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD",
    "flash_baud": 2000000
  },
  "wifi_ap": {
    "ssid": "SaveEarth",
    "password": "PlantMoreTrees123"
  },
  "paths": {
    "mode": "this_repo",
    "this_repo_root": "auto",
    "idf_path": "~/esp-idf",
    "cp_base": "auto",
    "host_base": "auto"
  },
  "build": {
    "strategy": "clean",
    "host_board_config": "auto",
    "slave_board_config": "auto",
    "host_board_sdkconfig": [
      "CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y"
    ],
    "slave_board_sdkconfig": [],
    "workspace_dir": "/tmp/workspace/",
    "sdkconfig_optimizations": [
      "CONFIG_SPIRAM_MEMTEST=n",
      "CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y"
    ]
  },
  "flash": {
    "strategy": "sequential",
    "baud": 2000000,
    "timeout_multiplier": 2,
    "overhead_s": 3,
    "compression_ratio": 0.65,
    "use_diff": false,
    "trust_flash_content": false,
    "force_full_flash": true
  },
  "test_order": "auto",
  "suite_overrides": {},
  "artifacts": {
    "log_retention": "full_always"
  },
  "suites": {
    "boot_wifi": true,
    "gpio": true,
    "peer_data": true,
    "mem_monitor": true,
    "bt_nimble": true,
    "bt_mac": true,
    "wifi_connect": true,
    "ota": true,
    "host_ps": true,
    "nw_split": true,
    "nw_split_ps": true,
    "light_sleep": true
  }
}
