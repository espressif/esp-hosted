{
  "_schema": {
    "cp": "this-repo path to CP example dir; relative to repo root.",
    "host_this_repo": "this-repo host path; mcu_host ↔ esp_host auto-fallback at resolve.",
    "host_legacy": "external (mcu6) host sub-path; joined with paths.host_base when mode=legacy.",
    "coverage": "Per-mode parity status. 'ok'=example prints what tests expect. 'incomplete'=example exists but lacks test-required output (build OK, tests fail). 'missing'=no example available. Runner skips non-ok pairs with reason."
  },
  "pairs": {
    "boot_wifi": {
