{
  "hardware": {
    "host_port": "/dev/cu.usbserial-120",
    "slave_port": "/dev/cu.usbserial-1301",
    "board": "p4_c6_core_board",
    "flash_baud": 2000000
  },

  "wifi_ap": {
    "ssid": "Yogesh",
    "password": "PlantMoreTrees123"
  },

  "paths": {
    "_doc": "mode=this_repo (default) | legacy. CP always this-repo. host_base='auto' → <repo>/_upstream_mcu/examples (symlink).",
    "mode": "this_repo",
    "this_repo_root": "auto",
    "host_base": "auto",
    "idf_path": "~/esp-idf"
  },

  "build": {
    "strategy": "fallback"
  },

  "artifacts": {
    "dir": "/tmp/esp_hosted_test_logs",
    "retention_days": 7
  },

  "suites": {
    "boot": true,
    "wifi_scan": true,
    "wifi_connect": true,
    "gpio": true,
    "peer_data": true,
    "mem_monitor": true,
    "bt": true,
    "bt_mac": true,
    "heartbeat": true,
    "ota": true
  }
}
