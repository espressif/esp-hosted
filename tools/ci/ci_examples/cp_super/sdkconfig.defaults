# ── CI-only super coprocessor ────────────────────────────────────────
# Enables every chip-independent CP feature so ONE build proves they all
# compile + link together. NOT a shipped example. Chip-specific overrides
# (Wi-Fi absent on h2, 802.15.4 only on c6/h2) live in sdkconfig.defaults.<chip>.
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

# All features on may exceed 4 MB — CI uses an 8 MB single-slot table for headroom.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ci_8m.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y

# Wi-Fi + network-split (every cp_super chip has Wi-Fi except h2, which overrides off).
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_HOSTED_CP_FEAT_NW_SPLIT=y
# Wi-Fi ext sub-features (chip-independent, off by default): DPP + Enterprise.
# (iTWT auto-enables on HE chips via SOC_WIFI_HE_SUPPORT.) On h2 these fold away
# with Wi-Fi (unmet deps are ignored by the h2 wifi-off override).
CONFIG_ESP_WIFI_DPP_SUPPORT=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI_EXT_DPP=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI_EXT_ENT=y

# Bluetooth controller, HCI relayed to the host (every cp_super chip has BT).
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y

# Chip-independent relays.
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y
CONFIG_ESP_HOSTED_CP_FEAT_GPIO_EXP=y
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS=y
# host-PS deep-sleep needs a valid wake GPIO (guarded by #error); cp_super has
# no board profile, so pin it here — compile-only, any valid pin proves the path.
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO=4
CONFIG_ESP_HOSTED_CP_FEAT_DEBUG=y
CONFIG_ESP_HOSTED_CP_FEAT_DEBUG_MEM_MONITOR=y
CONFIG_ESP_HOSTED_CP_FEAT_CLI=y
