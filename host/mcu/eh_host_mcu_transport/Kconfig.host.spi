# SPDX-License-Identifier: Apache-2.0
# SPI (full-duplex) transport — pins, clock, mode.
#
# Symbols consumed via host/include/eh_host_config.h as the EH_HOST_SPI_*
# redirector.  Default values below match the "typical ESP32 dev-board"
# wiring; override in sdkconfig.defaults or menuconfig for your board.

if ESP_HOSTED_HOST_TRANSPORT_BUS_SPI
	menu "SPI Configuration"

	choice ESP_HOSTED_HOST_SPI_CONTROLLER
		bool "SPI controller to use"
		default ESP_HOSTED_HOST_SPI_CONTROLLER_HSPI

		config ESP_HOSTED_HOST_SPI_CONTROLLER_HSPI
			bool "FSPI/HSPI"
		config ESP_HOSTED_HOST_SPI_CONTROLLER_VSPI
			depends on IDF_TARGET_ESP32
			bool "VSPI"
	endchoice

	menu "GPIO Configuration"

	# ── Per-board RANGE_MIN/MAX hidden configs ──────────────────────────
	# These lock the GPIO range to the exact board pin when a board is
	# selected, and fall back to 0/100 for generic (unconstrained) use.

	config ESP_HOSTED_SPI_RESET_RANGE_MIN
		int
		default 54 if ESP_HOSTED_P4_C5_CORE_BOARD || ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 54 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 9  if ESP32P4_EYE_C6_BOARD
		default 54 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 53 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default -1

	config ESP_HOSTED_SPI_RESET_RANGE_MAX
		int
		default 54 if ESP_HOSTED_P4_C5_CORE_BOARD || ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 54 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 9  if ESP32P4_EYE_C6_BOARD
		default 54 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 53 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 100

	config ESP_HOSTED_HOST_RESET_GPIO  # ignore: multiple-definition
		int "Slave reset GPIO (RST/EN line)"
		default 54 if ESP_HOSTED_P4_C5_CORE_BOARD || ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 54 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 9  if ESP32P4_EYE_C6_BOARD
		default 54 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 53 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 12 if IDF_TARGET_ESP32P4
		default 42 if IDF_TARGET_ESP32S3
		default 10 if ESP_HOSTED_CP_TARGET_ESP32H2
		default 5
		range ESP_HOSTED_SPI_RESET_RANGE_MIN ESP_HOSTED_SPI_RESET_RANGE_MAX

	config ESP_HOSTED_HOST_RESET_ACTIVE_LOW  # ignore: multiple-definition
		bool "Slave reset is active-low"
		# active-low so the reset pulse ends HIGH and the CP runs (as spi_hd/sdio)
		default y

	config ESP_HOSTED_SPI_MOSI_RANGE_MIN
			int
			default 49 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 14 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 50 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 29 if ESP32P4_EYE_C6_BOARD
			default 14 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 23 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 0

	config ESP_HOSTED_SPI_MOSI_RANGE_MAX
		int
		default 49 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 14 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 50 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 29 if ESP32P4_EYE_C6_BOARD
		default 14 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 23 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 100

	config ESP_HOSTED_HOST_SPI_MOSI_GPIO
		int "SPI MOSI GPIO"
		default 49 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 14 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 50 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 29 if ESP32P4_EYE_C6_BOARD
		default 14 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 23 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 8  if IDF_TARGET_ESP32P4
		default 13 if IDF_TARGET_ESP32
		default 11 if IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32S3
		default 5  if ESP_HOSTED_CP_TARGET_ESP32H2
		default 7
		range ESP_HOSTED_SPI_MOSI_RANGE_MIN ESP_HOSTED_SPI_MOSI_RANGE_MAX

	config ESP_HOSTED_SPI_MISO_RANGE_MIN
		int
		default 48 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 15 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 49 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 30 if ESP32P4_EYE_C6_BOARD
		default 15 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 22 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 0

	config ESP_HOSTED_SPI_MISO_RANGE_MAX
		int
		default 48 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 15 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 49 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 30 if ESP32P4_EYE_C6_BOARD
		default 15 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 22 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 100

	config ESP_HOSTED_HOST_SPI_MISO_GPIO
		int "SPI MISO GPIO"
		default 48 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 15 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 49 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 30 if ESP32P4_EYE_C6_BOARD
		default 15 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 22 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 10 if IDF_TARGET_ESP32P4
		default 12 if IDF_TARGET_ESP32
		default 13 if IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32S3
		default 0  if ESP_HOSTED_CP_TARGET_ESP32H2
		default 2
		range ESP_HOSTED_SPI_MISO_RANGE_MIN ESP_HOSTED_SPI_MISO_RANGE_MAX

	config ESP_HOSTED_SPI_CLK_RANGE_MIN
		int
		default 50 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 18 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 51 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 28 if ESP32P4_EYE_C6_BOARD
		default 18 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 33 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 0

	config ESP_HOSTED_SPI_CLK_RANGE_MAX
		int
		default 50 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 18 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 51 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 28 if ESP32P4_EYE_C6_BOARD
		default 18 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 33 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 100

	config ESP_HOSTED_HOST_SPI_CLK_GPIO
		int "SPI CLK GPIO"
		default 50 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 18 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 51 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 28 if ESP32P4_EYE_C6_BOARD
		default 18 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 33 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 9  if IDF_TARGET_ESP32P4
		default 14 if IDF_TARGET_ESP32
		default 12 if IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32S3
		default 4  if ESP_HOSTED_CP_TARGET_ESP32H2
		default 0  if IDF_TARGET_ESP32C2 && ESP_HOSTED_C2_C5_MODULE_SUB_BOARD
		default 3  if IDF_TARGET_ESP32C5 && ESP_HOSTED_C2_C5_MODULE_SUB_BOARD
		default 6
		range ESP_HOSTED_SPI_CLK_RANGE_MIN ESP_HOSTED_SPI_CLK_RANGE_MAX

	config ESP_HOSTED_SPI_CS_RANGE_MIN
		int
		default 51 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 19 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 52 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 27 if ESP32P4_EYE_C6_BOARD
		default 19 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 4  if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 0

	config ESP_HOSTED_SPI_CS_RANGE_MAX
		int
		default 51 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 19 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 52 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 27 if ESP32P4_EYE_C6_BOARD
		default 19 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 4  if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 100

	config ESP_HOSTED_HOST_SPI_CS_GPIO
		int "SPI CS GPIO"
		default 51 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 19 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 52 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 27 if ESP32P4_EYE_C6_BOARD
		default 19 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 4  if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 7  if IDF_TARGET_ESP32P4
		default 15 if IDF_TARGET_ESP32
		default 10 if IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32S3
		default 1  if ESP_HOSTED_CP_TARGET_ESP32H2
		default 10
		range ESP_HOSTED_SPI_CS_RANGE_MIN ESP_HOSTED_SPI_CS_RANGE_MAX

	config ESP_HOSTED_SPI_HANDSHAKE_RANGE_MIN
		int
		default 53 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 16 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 48 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 31 if ESP32P4_EYE_C6_BOARD
		default 16 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 21 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 0

	config ESP_HOSTED_SPI_HANDSHAKE_RANGE_MAX
		int
		default 53 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 16 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 48 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 31 if ESP32P4_EYE_C6_BOARD
		default 16 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 21 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 100

	config ESP_HOSTED_HOST_HANDSHAKE_GPIO
		int "Handshake GPIO (CP→host ready-to-transact)"
		default 53 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 16 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 48 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 31 if ESP32P4_EYE_C6_BOARD
		default 16 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 21 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 6  if IDF_TARGET_ESP32P4
		default 22 if ESP_HOSTED_CP_TARGET_ESP32H2
		default 18 if IDF_TARGET_ESP32C2 && ESP_HOSTED_C2_C5_MODULE_SUB_BOARD
		default 4  if IDF_TARGET_ESP32C5 && ESP_HOSTED_C2_C5_MODULE_SUB_BOARD
		default 3  if IDF_TARGET_ESP32C2 || IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C6
		default 17 if IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32S3
		default 26
		range ESP_HOSTED_SPI_HANDSHAKE_RANGE_MIN ESP_HOSTED_SPI_HANDSHAKE_RANGE_MAX

	choice ESP_HOSTED_SPI_HANDSHAKE_GPIO_CONFIG
		prompt "Handshake GPIO active level"
		default ESP_HOSTED_SPI_HANDSHAKE_ACTIVE_HIGH
		config ESP_HOSTED_SPI_HANDSHAKE_ACTIVE_HIGH
			bool "Active high"
		config ESP_HOSTED_SPI_HANDSHAKE_ACTIVE_LOW
			bool "Active low"
	endchoice

	config ESP_HOSTED_SPI_DATA_READY_RANGE_MIN
		int
		default 52 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 17 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 47 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 32 if ESP32P4_EYE_C6_BOARD
		default 17 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 32 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 0

	config ESP_HOSTED_SPI_DATA_READY_RANGE_MAX
		int
		default 52 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 17 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 47 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 32 if ESP32P4_EYE_C6_BOARD
		default 17 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 32 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 100

	config ESP_HOSTED_HOST_DATA_READY_GPIO
		int "Data-ready GPIO (CP→host rx-pending)"
		default 52 if ESP_HOSTED_P4_C5_CORE_BOARD
		default 17 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
		default 47 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
		default 32 if ESP32P4_EYE_C6_BOARD
		default 17 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
		default 32 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
		default 11 if IDF_TARGET_ESP32P4
		default 12 if ESP_HOSTED_CP_TARGET_ESP32H2
		default 1  if IDF_TARGET_ESP32C2 && ESP_HOSTED_C2_C5_MODULE_SUB_BOARD
		default 0  if IDF_TARGET_ESP32C5 && ESP_HOSTED_C2_C5_MODULE_SUB_BOARD
		default 4
		range ESP_HOSTED_SPI_DATA_READY_RANGE_MIN ESP_HOSTED_SPI_DATA_READY_RANGE_MAX

	choice ESP_HOSTED_SPI_DATAREADY_GPIO_CONFIG
		prompt "DataReady GPIO active level"
		default ESP_HOSTED_SPI_DATAREADY_ACTIVE_HIGH
		config ESP_HOSTED_SPI_DATAREADY_ACTIVE_HIGH
			bool "Active high"
		config ESP_HOSTED_SPI_DATAREADY_ACTIVE_LOW
			bool "Active low"
	endchoice

	endmenu

	# ── SPI clock frequency ─────────────────────────────────────────────
	# Per-CP-target ranges matching upstream.
	# ESP32: max 10 MHz; H2: max 32 MHz; all others: max 40 MHz.

	config ESP_HOSTED_HOST_SPI_CLK_MHZ
		int "SPI clock (MHz)"
		default 10 if ESP_HOSTED_CP_TARGET_ESP32
		default 32 if ESP_HOSTED_CP_TARGET_ESP32H2
		default 26 if ESP_HOSTED_CP_TARGET_ESP32C6
		default 40 if ESP_HOSTED_CP_TARGET_ESP32C2 || ESP_HOSTED_CP_TARGET_ESP32C3 || ESP_HOSTED_CP_TARGET_ESP32S2 || ESP_HOSTED_CP_TARGET_ESP32S3 || ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C61
		default 10
		range 1 10 if ESP_HOSTED_CP_TARGET_ESP32
		range 1 32 if ESP_HOSTED_CP_TARGET_ESP32H2
		range 1 40

	config ESP_HOSTED_HOST_SPI_MODE
		int "SPI mode (0-3)"
		default 2 if ESP_HOSTED_CP_TARGET_ESP32
		default 3
		range 0 3
		help
		  Must equal the CP-side SPI slave mode (CPOL/CPHA agree on both
		  ends). The CP slave defaults to mode 2 on ESP32 and mode 3 on
		  all other targets (Kconfig.cp.spi); this default tracks that.

	config ESP_HOSTED_HOST_SPI_TX_Q_SIZE
		int "Host SPI Tx queue size"
		default 20

	config ESP_HOSTED_HOST_SPI_RX_Q_SIZE
		int "Host SPI Rx queue size"
		default 20

	endmenu

endif # ESP_HOSTED_HOST_TRANSPORT_BUS_SPI
