# SPDX-License-Identifier: Apache-2.0
# SPI half-duplex transport — 4-line quad pinout + CS + CLK.
# SPI-HD uses D0/D1/D2/D3 instead of MOSI/MISO.

if ESP_HOSTED_HOST_TRANSPORT_BUS_SPI_HD
	menu "SPI Half Duplex Configuration"

	config ESP_HOSTED_HOST_SPI_HD_MODE
		int "SPI mode (0-3)"
		default 3
		range 0 3

	choice ESP_HOSTED_HOST_SPI_HD_DATA_LINES
		bool "Num data lines"
		default ESP_HOSTED_HOST_SPI_HD_4_DATA_LINES
		config ESP_HOSTED_HOST_SPI_HD_4_DATA_LINES
			bool "4 data lines"
		config ESP_HOSTED_HOST_SPI_HD_2_DATA_LINES
			bool "2 data lines"
		config ESP_HOSTED_HOST_SPI_HD_1_DATA_LINE
			bool "1 data line"
	endchoice

	config ESP_HOSTED_HOST_SPI_HD_NUM_DATA_LINES
		int
		default 4 if ESP_HOSTED_HOST_SPI_HD_4_DATA_LINES
		default 2 if ESP_HOSTED_HOST_SPI_HD_2_DATA_LINES
		default 1

	menu "GPIO Configuration"

		# ── Reset GPIO ──────────────────────────────────────────────────

		config ESP_HOSTED_SPI_HD_RESET_RANGE_MIN
			int
			default 54 if ESP_HOSTED_P4_C5_CORE_BOARD || ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 54 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 9  if ESP32P4_EYE_C6_BOARD
			default 54 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 53 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default -1

		config ESP_HOSTED_SPI_HD_RESET_RANGE_MAX
			int
			default 54 if ESP_HOSTED_P4_C5_CORE_BOARD || ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 54 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 9  if ESP32P4_EYE_C6_BOARD
			default 54 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 53 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 100

		config ESP_HOSTED_HOST_RESET_GPIO
			int "Slave reset GPIO (RST/EN line)"
			default 54 if ESP_HOSTED_P4_C5_CORE_BOARD || ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 54 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 9  if ESP32P4_EYE_C6_BOARD
			default 54 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 53 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 12 if IDF_TARGET_ESP32P4
			default 5  if IDF_TARGET_ESP32S3
			default 10 if ESP_HOSTED_CP_TARGET_ESP32H2
			default 5
			range ESP_HOSTED_SPI_HD_RESET_RANGE_MIN ESP_HOSTED_SPI_HD_RESET_RANGE_MAX

		choice ESP_HOSTED_SPI_HD_RESET_GPIO_CONFIG
			prompt "Slave reset active level"
			default ESP_HOSTED_SPI_HD_RESET_ACTIVE_LOW
			config ESP_HOSTED_SPI_HD_RESET_ACTIVE_HIGH
				bool "Active high"
			config ESP_HOSTED_SPI_HD_RESET_ACTIVE_LOW
				bool "Active low"
		endchoice

		config ESP_HOSTED_HOST_RESET_ACTIVE_LOW
			bool
			default y if ESP_HOSTED_SPI_HD_RESET_ACTIVE_LOW
			default n

		choice ESP_HOSTED_SPI_HD_DATAREADY_GPIO_CONFIG
			prompt "DataReady GPIO active level"
			default ESP_HOSTED_SPI_HD_DR_ACTIVE_HIGH
			config ESP_HOSTED_SPI_HD_DR_ACTIVE_HIGH
				bool "Active high"
			config ESP_HOSTED_SPI_HD_DR_ACTIVE_LOW
				bool "Active low"
		endchoice


		# ── CS ──────────────────────────────────────────────────────────

		config ESP_HOSTED_SPI_HD_CS_RANGE_MIN
			int
			default 51 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 19 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 52 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 27 if ESP32P4_EYE_C6_BOARD
			default 19 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 4  if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default -1

		config ESP_HOSTED_SPI_HD_CS_RANGE_MAX
			int
			default 51 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 19 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 52 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 27 if ESP32P4_EYE_C6_BOARD
			default 19 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 4  if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 100

		config ESP_HOSTED_HOST_SPI_HD_CS_GPIO
			int "SPI-HD CS GPIO"
			default 51 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 19 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 52 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 27 if ESP32P4_EYE_C6_BOARD
			default 19 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 4  if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 7  if IDF_TARGET_ESP32P4
			default 10 if IDF_TARGET_ESP32S3
			default 1  if ESP_HOSTED_CP_TARGET_ESP32H2
			default 5
			range ESP_HOSTED_SPI_HD_CS_RANGE_MIN ESP_HOSTED_SPI_HD_CS_RANGE_MAX

		# ── CLK ─────────────────────────────────────────────────────────

		config ESP_HOSTED_SPI_HD_CLK_RANGE_MIN
			int
			default 50 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 18 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 51 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 28 if ESP32P4_EYE_C6_BOARD
			default 18 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 33 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default -1

		config ESP_HOSTED_SPI_HD_CLK_RANGE_MAX
			int
			default 50 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 18 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 51 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 28 if ESP32P4_EYE_C6_BOARD
			default 18 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 33 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 100

		config ESP_HOSTED_HOST_SPI_HD_CLK_GPIO
			int "SPI-HD CLK GPIO"
			default 50 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 18 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 51 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 28 if ESP32P4_EYE_C6_BOARD
			default 18 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 33 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 9  if IDF_TARGET_ESP32P4
			default 12 if IDF_TARGET_ESP32S3
			default 4  if ESP_HOSTED_CP_TARGET_ESP32H2
			default 18
			range ESP_HOSTED_SPI_HD_CLK_RANGE_MIN ESP_HOSTED_SPI_HD_CLK_RANGE_MAX

		# ── D0 ──────────────────────────────────────────────────────────

		config ESP_HOSTED_SPI_HD_D0_RANGE_MIN
			int
			default 49 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 14 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 50 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 29 if ESP32P4_EYE_C6_BOARD
			default 14 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 23 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default -1

		config ESP_HOSTED_SPI_HD_D0_RANGE_MAX
			int
			default 49 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 14 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 50 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 29 if ESP32P4_EYE_C6_BOARD
			default 14 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 23 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 100

		config ESP_HOSTED_HOST_SPI_HD_D0_GPIO
			int "SPI-HD D0 GPIO"
			default 49 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 14 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 50 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 29 if ESP32P4_EYE_C6_BOARD
			default 14 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 23 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 8  if IDF_TARGET_ESP32P4
			default 11 if IDF_TARGET_ESP32S3
			default 5  if ESP_HOSTED_CP_TARGET_ESP32H2
			default 23
			range ESP_HOSTED_SPI_HD_D0_RANGE_MIN ESP_HOSTED_SPI_HD_D0_RANGE_MAX

		# ── D1 ──────────────────────────────────────────────────────────

		config ESP_HOSTED_SPI_HD_D1_RANGE_MIN
			int
			default 48 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 15 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 49 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 30 if ESP32P4_EYE_C6_BOARD
			default 15 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 22 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default -1

		config ESP_HOSTED_SPI_HD_D1_RANGE_MAX
			int
			default 48 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 15 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 49 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 30 if ESP32P4_EYE_C6_BOARD
			default 15 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 22 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 100

		config ESP_HOSTED_HOST_SPI_HD_D1_GPIO
			int "SPI-HD D1 GPIO"
			default 48 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 15 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 49 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 30 if ESP32P4_EYE_C6_BOARD
			default 15 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 22 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 10 if IDF_TARGET_ESP32P4
			default 13 if IDF_TARGET_ESP32S3
			default 0  if ESP_HOSTED_CP_TARGET_ESP32H2
			default 19
			range ESP_HOSTED_SPI_HD_D1_RANGE_MIN ESP_HOSTED_SPI_HD_D1_RANGE_MAX

		# ── D2 ──────────────────────────────────────────────────────────

		config ESP_HOSTED_SPI_HD_D2_RANGE_MIN
			int
			default 53 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 16 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 48 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 31 if ESP32P4_EYE_C6_BOARD
			default 16 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 20 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default -1

		config ESP_HOSTED_SPI_HD_D2_RANGE_MAX
			int
			default 53 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 16 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 48 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 31 if ESP32P4_EYE_C6_BOARD
			default 16 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 20 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 100

		config ESP_HOSTED_HOST_SPI_HD_D2_GPIO
			int "SPI-HD D2 GPIO"
			depends on ESP_HOSTED_HOST_SPI_HD_4_DATA_LINES
			default 53 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 16 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 48 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 31 if ESP32P4_EYE_C6_BOARD
			default 16 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 20 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 11 if IDF_TARGET_ESP32P4
			default 14 if IDF_TARGET_ESP32S3
			default 2  if ESP_HOSTED_CP_TARGET_ESP32H2
			default 22
			range ESP_HOSTED_SPI_HD_D2_RANGE_MIN ESP_HOSTED_SPI_HD_D2_RANGE_MAX

		# ── D3 ──────────────────────────────────────────────────────────

		config ESP_HOSTED_SPI_HD_D3_RANGE_MIN
			int
			default 52 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 17 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 47 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 32 if ESP32P4_EYE_C6_BOARD
			default 17 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 21 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default -1

		config ESP_HOSTED_SPI_HD_D3_RANGE_MAX
			int
			default 52 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 17 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 47 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 32 if ESP32P4_EYE_C6_BOARD
			default 17 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 21 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 100

		config ESP_HOSTED_HOST_SPI_HD_D3_GPIO
			int "SPI-HD D3 GPIO"
			depends on ESP_HOSTED_HOST_SPI_HD_4_DATA_LINES
			default 52 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 17 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 47 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 32 if ESP32P4_EYE_C6_BOARD
			default 17 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 21 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 6  if IDF_TARGET_ESP32P4
			default 9  if IDF_TARGET_ESP32S3
			default 3  if ESP_HOSTED_CP_TARGET_ESP32H2
			default 21
			range ESP_HOSTED_SPI_HD_D3_RANGE_MIN ESP_HOSTED_SPI_HD_D3_RANGE_MAX

		# ── DataReady ────────────────────────────────────────────────────

		config ESP_HOSTED_SPI_HD_DATA_READY_RANGE_MIN
			int
			default 47 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 6 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 53 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 33 if ESP32P4_EYE_C6_BOARD
			default 6  if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 32 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default -1

		config ESP_HOSTED_SPI_HD_DATA_READY_RANGE_MAX
			int
			default 47 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 6 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 53 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 33 if ESP32P4_EYE_C6_BOARD
			default 6  if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 32 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 100

		config ESP_HOSTED_HOST_SPI_HD_DATA_READY_GPIO
			int "SPI-HD data ready GPIO"
			default 47 if ESP_HOSTED_P4_C5_CORE_BOARD
			default 6 if ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD
			default 53 if ESP_HOSTED_P4_C6_CORE_BOARD || ESP_HOSTED_P4_C61_CORE_BOARD
			default 33 if ESP32P4_EYE_C6_BOARD
			default 6  if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && ESP_HOSTED_CP_TARGET_ESP32C6
			default 32 if ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD && (ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C2)
			default 13 if IDF_TARGET_ESP32P4
			default 4  if IDF_TARGET_ESP32S3
			default 12 if ESP_HOSTED_CP_TARGET_ESP32H2
			default 8
			range ESP_HOSTED_SPI_HD_DATA_READY_RANGE_MIN ESP_HOSTED_SPI_HD_DATA_READY_RANGE_MAX

	endmenu

	# ── SPI-HD clock frequency ──────────────────────────────────────────
	# Per-CP-target ranges matching upstream.
	# ESP32: max 10 MHz; C6: max 40 MHz; all others: max 40 MHz.

	config ESP_HOSTED_HOST_SPI_HD_CLK_MHZ
		int "SPI-HD clock (MHz)"
		default 10 if ESP_HOSTED_CP_TARGET_ESP32
		default 40 if ESP_HOSTED_CP_TARGET_ESP32C6
		default 40 if ESP_HOSTED_CP_TARGET_ESP32C2 || ESP_HOSTED_CP_TARGET_ESP32C3 || ESP_HOSTED_CP_TARGET_ESP32S2 || ESP_HOSTED_CP_TARGET_ESP32S3 || ESP_HOSTED_CP_TARGET_ESP32C5 || ESP_HOSTED_CP_TARGET_ESP32C61
		default 10
		range 1 10 if ESP_HOSTED_CP_TARGET_ESP32
		range 1 40

	config ESP_HOSTED_HOST_SPI_HD_TX_Q_SIZE
		int "Host SPI-HD Tx queue size"
		default 20

	config ESP_HOSTED_HOST_SPI_HD_RX_Q_SIZE
		int "Host SPI-HD Rx queue size"
		default 20
	endmenu

endif # ESP_HOSTED_HOST_TRANSPORT_BUS_SPI_HD
