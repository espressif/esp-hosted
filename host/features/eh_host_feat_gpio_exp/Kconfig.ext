menuconfig ESP_HOSTED_HOST_FEAT_GPIO_EXP
	bool "GPIO Expander"
	default n
	depends on ESP_HOSTED_HOST && ESP_HOSTED_HOST_FEAT_RPC
	depends on ESP_HOSTED_HOST_FEAT_RPC_EXT_V2_READY
	help
	  Exposes the coprocessor's GPIO controller to host callers as a
	  "GPIO expander" — a set of RPCs that configure, read, write,
	  interrupt-enable and hold pins on the CP device.

	  This is distinct from the host's local GPIO (served by the
	  eh_port_gpio port API on the host MCU or Linux).  The expander
	  acts on CP-side pins only; the two surfaces do not share
	  numbering or lifecycle.

if ESP_HOSTED_HOST_FEAT_GPIO_EXP

	config ESP_HOSTED_HOST_FEAT_GPIO_EXP_AUTO_INIT
		bool "Auto-initialize GPIO-expander feature at boot"
		default y
		depends on ESP_HOSTED_HOST_AUTO_FEAT_INIT
		help
		  When enabled, eh_host_feat_gpio_exp_init() runs during the
		  linker-section auto-init walk.

endif # ESP_HOSTED_HOST_FEAT_GPIO_EXP

config ESP_HOSTED_HOST_FEAT_GPIO_EXP_READY
	bool
	default y if ESP_HOSTED_HOST_FEAT_GPIO_EXP && ESP_HOSTED_HOST_FEAT_RPC_READY && ESP_HOSTED_HOST_FEAT_RPC_EXT_V2_READY
