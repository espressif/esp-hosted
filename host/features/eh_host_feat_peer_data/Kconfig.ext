menuconfig ESP_HOSTED_HOST_FEAT_PEER_DATA
	bool "Peer Data Transfer"
	default n
	depends on ESP_HOSTED_HOST && ESP_HOSTED_HOST_FEAT_RPC
	depends on ESP_HOSTED_HOST_FEAT_RPC_EXT_V2_READY
	help
	  Requires the MCU V1 RPC extension — Custom_RPC IDs only exist
	  in the Rpc proto family.  Linux-FG (CtrlMsg) support is deferred.

	  Exposes a typed-blob send/echo RPC and subscribes the
	  per-peer tx/rx status events from the CP side.

if ESP_HOSTED_HOST_FEAT_PEER_DATA

	config ESP_HOSTED_HOST_FEAT_PEER_DATA_AUTO_INIT
		bool "Auto-initialize Peer-Data feature at boot"
		default y
		depends on ESP_HOSTED_HOST_AUTO_FEAT_INIT
		help
		  When enabled, eh_host_feat_peer_data_init() runs during the
		  linker-section auto-init walk.

	config ESP_HOSTED_HOST_FEAT_PEER_DATA_MAX_CUSTOM_MSG_HANDLERS
		int "Maximum custom message handlers"
		range 1 32
		default 3
		help
		  Max concurrent custom RPC message handlers.

endif # ESP_HOSTED_HOST_FEAT_PEER_DATA

config ESP_HOSTED_HOST_FEAT_PEER_DATA_READY
	bool
	default y if ESP_HOSTED_HOST_FEAT_PEER_DATA && ESP_HOSTED_HOST_FEAT_RPC_READY && ESP_HOSTED_HOST_FEAT_RPC_EXT_V2_READY
